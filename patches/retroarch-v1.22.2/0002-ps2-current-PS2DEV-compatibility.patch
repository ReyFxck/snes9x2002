From bcc19e8ac9a044552e583f52ef9ad2b6b92259b9 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sun, 4 Oct 2026 17:37:47 -0300
Subject: [PATCH 2/2] ps2: update calls for current PS2DEV toolchain

---
 frontend/drivers/platform_ps2.c | 4 ++--
 gfx/drivers/ps2_gfx.c           | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/frontend/drivers/platform_ps2.c b/frontend/drivers/platform_ps2.c
index f8e7e9b..12d3832 100644
--- a/frontend/drivers/platform_ps2.c
+++ b/frontend/drivers/platform_ps2.c
@@ -152,7 +152,7 @@ static void init_drivers(bool extra_drivers)
 {
    init_fileXio_driver();
    init_memcard_driver(true);
-   init_usb_driver();
+   init_usb_driver(true);
    init_cdfs_driver();
    bool only_if_booted_from_hdd = true;
 #if defined(DEBUG) && !defined(BUILD_FOR_PCSX2)
@@ -239,7 +239,7 @@ static void deinit_drivers(bool deinit_filesystem, bool deinit_powerOff)
       umount_hdd_partition(mountString);
 
       deinit_hdd_driver(false);
-      deinit_usb_driver();
+      deinit_usb_driver(true);
       deinit_memcard_driver(true);
       deinit_fileXio_driver();
 
diff --git a/gfx/drivers/ps2_gfx.c b/gfx/drivers/ps2_gfx.c
index 22fee34..3e0e360 100644
--- a/gfx/drivers/ps2_gfx.c
+++ b/gfx/drivers/ps2_gfx.c
@@ -468,7 +468,7 @@ font_renderer_t ps2_font = {
  */
 
 /* PRIVATE METHODS */
-static int vsync_handler(void)
+static int vsync_handler(int reason)
 {
    iSignalSema(vsync_sema_id);
 
-- 
