From e89c713e3c537543fab81d261c5c2ae6f28bf9dd Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sun, 4 Oct 2026 19:49:34 -0300
Subject: [PATCH] ps2: normalize HostFS file paths before opening

---
 libretro-common/vfs/vfs_implementation.c | 45 ++++++++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/libretro-common/vfs/vfs_implementation.c b/libretro-common/vfs/vfs_implementation.c
index 4dab22f..fe654fc 100644
--- a/libretro-common/vfs/vfs_implementation.c
+++ b/libretro-common/vfs/vfs_implementation.c
@@ -97,6 +97,37 @@
 #include <retro_miscellaneous.h>
 #include <encodings/utf.h>
 
+#if defined(PS2)
+/*
+ * NetherSX2's HostFS treats the slash in "host:/path" as the start of an
+ * absolute path and rejects it for escaping the ELF directory.  ps2link-style
+ * HostFS accepts the equivalent relative spelling, "host:path".
+ */
+static const char *retro_vfs_ps2_normalize_host_path(
+      const char *path, char *normalized, size_t normalized_size)
+{
+   const char *relative_path;
+   size_t prefix_length = sizeof("host:") - 1;
+
+   if (!path || !string_starts_with(path, "host:/"))
+      return path;
+
+   relative_path = path + prefix_length;
+   while (*relative_path == '/')
+      relative_path++;
+
+   if (normalized_size <= prefix_length ||
+       strlen(relative_path) >= normalized_size - prefix_length)
+      return path;
+
+   memcpy(normalized, "host:", prefix_length);
+   strlcpy(normalized + prefix_length, relative_path,
+         normalized_size - prefix_length);
+
+   return normalized;
+}
+#endif
+
 #if defined(_WIN32)
 #ifndef _XBOX
 #if defined(_MSC_VER) && _MSC_VER <= 1200
@@ -311,10 +342,18 @@ libretro_vfs_implementation_file *retro_vfs_file_open_impl(
 {
    int                                flags = 0;
    const char                     *mode_str = NULL;
+#if defined(PS2)
+   char                    normalized_path[PATH_MAX_LENGTH];
+#endif
    libretro_vfs_implementation_file *stream =
       (libretro_vfs_implementation_file*)
       malloc(sizeof(*stream));
 
+#if defined(PS2)
+   path = retro_vfs_ps2_normalize_host_path(path, normalized_path,
+         sizeof(normalized_path));
+#endif
+
    if (!stream)
       return NULL;
 
@@ -980,6 +1019,12 @@ const char *retro_vfs_file_get_path_impl(
 int retro_vfs_stat_impl(const char *path, int32_t *size)
 {
    int ret                   = RETRO_VFS_STAT_IS_VALID;
+#if defined(PS2)
+   char normalized_path[PATH_MAX_LENGTH];
+
+   path = retro_vfs_ps2_normalize_host_path(path, normalized_path,
+         sizeof(normalized_path));
+#endif
 
    if (!path || !*path)
       return 0;
-- 
